# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Database URL
# Example for Supabase: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Application Security & Sessions
SESSION_SECRET=a_very_long_random_secret_at_least_32_characters_long
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Security flags (set to true in production on Render HTTPS)
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Level 3 Enterprise Admin Bootstrap Credentials (One-time, idempotent startup provisioning)
# Set ADMIN_BOOTSTRAP_ENABLED=true only during initial setup with an explicitly configured strong password.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=your_strong_bootstrap_password_min_12_chars_with_symbols
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.internal
