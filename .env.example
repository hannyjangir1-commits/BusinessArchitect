# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / Supabase Database URL (Required in production, SQLite is rejected in production)
# Example for Supabase: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Application Security & Sessions (Must be at least 32 characters; dev fallbacks rejected in production)
SESSION_SECRET=a_very_long_random_secret_at_least_32_characters_long
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Security flags (automatically enforced as true in production; cookies use SameSite=Lax and secure flags)
COOKIE_SECURE=false

# Allowed Origins (Required in production; comma-separated frontend URLs, e.g. https://your-domain.onrender.com)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Administrator Bootstrap Credentials (One-time, idempotent startup provisioning)
# Set ADMIN_BOOTSTRAP_ENABLED=true only during initial setup with an explicitly configured strong secret password.
# Username defaults to HannyAdmin if omitted. Password must be at least 12 characters with upper, lower, numbers, and symbols.
# Both INITIAL_ADMIN_* and ADMIN_BOOTSTRAP_* aliases are supported.
ADMIN_BOOTSTRAP_ENABLED=false
INITIAL_ADMIN_USERNAME=HannyAdmin
INITIAL_ADMIN_PASSWORD=your_strong_bootstrap_password_min_12_chars_with_symbols
INITIAL_ADMIN_EMAIL=admin@yourdomain.internal

